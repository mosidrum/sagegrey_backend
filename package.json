{
  "name": "gome-api",
  "version": "1.0.0",
  "private": true,
  "description": "GoMe backend API",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "docker compose up --attach gome-api",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "DB_NAME=app_test jest --runInBand",
    "test:watch": "DB_NAME=app_test jest --watch --runInBand",
    "test:migrate": "DB_NAME=app_test npm run knex -- migrate:latest",
    "pretest": "npm run test:migrate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "knex": "knex --knexfile src/database/knexfile.ts",
    "migrate": "docker compose exec gome-api npm run knex -- migrate:latest",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down --volumes"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0"
  }
}
